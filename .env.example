# ── Permit AI environment ────────────────────────────────────────────────
# The deterministic rules engine (PASS/FAIL, violations, citations, PDF) works
# with NO keys. A model key upgrades the natural-language reasoning + chat and
# enables real vision plan-extraction from uploads.

# PREFERRED: Google Gemini (capable multimodal, generous free tier).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model override. For Gemini use e.g. gemini-2.5-flash (default) or
# gemini-2.5-pro (stronger reasoning). For the gateway use a full slug like
# anthropic/claude-sonnet-5.
PERMIT_AI_MODEL=gemini-2.5-flash

# ── Alternatives (only if not using Gemini) ──────────────────────────────
# Vercel AI Gateway (auto via OIDC on Vercel; frontier models need paid credits)
AI_GATEWAY_API_KEY=
# Direct Anthropic key
ANTHROPIC_API_KEY=

# ── Security ──────────────────────────────────────────────────────────────
# 32-byte base64 key for PII field encryption at rest. openssl rand -base64 32
PII_ENCRYPTION_KEY=
# In-memory rate limit (requests/min/IP)
RATE_LIMIT_PER_MINUTE=20

# HMAC secret that signs role-session cookies. MUST be set in production.
# openssl rand -base64 48
AUTH_SECRET=
# Access codes gating the privileged roles (server-verified, constant-time).
# Defaults (demo-architect / demo-official) apply only if unset — override these.
ARCHITECT_ACCESS_CODE=
OFFICIAL_ACCESS_CODE=
